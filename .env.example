# Copia este archivo a .env y ajusta los valores. NUNCA commitees .env.
# Todos los valores de aquí son de desarrollo y no sirven para producción.

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_DIR=/data

# --- Base de datos (servicio postgres del compose) ---
POSTGRES_USER=caterin
POSTGRES_PASSWORD=caterin_dev
POSTGRES_DB=caterin
DATABASE_URL=postgresql+psycopg://caterin:caterin_dev@postgres:5432/caterin
TEST_DATABASE_URL=postgresql+psycopg://caterin:caterin_dev@postgres:5432/caterin_test

# --- Autenticación ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MIN=15
# Cookie de refresh solo por HTTPS (localhost cuenta como seguro en los navegadores)
REFRESH_COOKIE_SECURE=true

# --- Asistente (F1). Umbral y margen son PROVISIONALES, no están calibrados (T10) ---
ASSISTANT_ROUTER_THRESHOLD=0.65
ASSISTANT_ROUTER_MARGIN=0.03
# Nivel 1: el LLM redacta con el dato ya resuelto. Apagado hasta medir la calidad de redacción.
ASSISTANT_USE_LLM=false
ASSISTANT_CACHE_SIZE=512
# Nivel 2 (documentos): fragmentos que recibe el LLM y similitud mínima de un fragmento. PROVISIONALES (T10).
ASSISTANT_RAG_K=4
ASSISTANT_RAG_MIN_SIMILARITY=0.45
DOCUMENT_MAX_UPLOAD_MB=10

# --- Embeddings (bge-m3 en Ollama: `ollama pull bge-m3`) ---
# ollama | fake (solo pruebas) | disabled (la búsqueda en documentos queda solo por texto)
EMBEDDINGS_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_VERSION=bge-m3-ollama-1
EMBEDDING_TIMEOUT_S=30

# --- Visión: conteo por foto (F2) ---
# Carpeta con model.onnx y model.json (ver ml/vision/README.md). Sin modelo, /vision/count responde 503.
VISION_MODEL_PATH=/data/models/vision/model.onnx
VISION_THRESHOLD=0.5
VISION_MAX_IMAGE_MB=15

# --- LLM (AGENTS.md sección 3.1) ---
# ollama | fake (solo pruebas) | disabled (sin LLM: el pedido se ingresa con formulario)
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_S=60
LLM_KEEP_ALIVE=30m

# --- Puertos del host (opcionales) ---
# POSTGRES_HOST_PORT=5433
# API_HOST_PORT=8000
# WEB_HOST_PORT=5173
